[Desktop Entry]
Version=1.0
Type=Application
Name=DSH Desktop
GenericName=AI Coding Agent
Comment=Tray-capable desktop shell for DeepSeek Harness (X hides to tray)
Comment[tr]=DeepSeek Harness icin tepsi destekli masaustu kabugu (X = tepsiye gizle)
Exec=@BIN_DIR@/dsh-desktop-launch.sh
